# Doxygen configuration for the API reference (doxygen Doxyfile -> build-docs/html).
PROJECT_NAME           = "radar-signal-processing-sim"
PROJECT_NUMBER         = 1.0.0
PROJECT_BRIEF          = "Pulse-Doppler radar signal processing simulator in C++17"
OUTPUT_DIRECTORY       = build-docs
INPUT                  = docs/mainpage.md include/radar src
USE_MDFILE_AS_MAINPAGE = docs/mainpage.md
FILE_PATTERNS          = *.hpp *.cpp *.md
RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = include
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
USE_MATHJAX            = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
HTML_COLORSTYLE        = AUTO_LIGHT
HAVE_DOT               = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
CLASS_GRAPH            = YES
INCLUDE_GRAPH          = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
